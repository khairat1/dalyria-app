# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".
# No quotes, no spaces around "=".
# Only PUBLIC client keys go here. NEVER put a Supabase secret key (sb_secret_...)
# or the old service_role key in this file: these values are compiled into the app.
# Run the app with:  flutter run --dart-define-from-file=.env

# Supabase: Project Settings > API Keys / Data API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Cloud: restricted Maps SDK for Android key (read by Gradle at build time)
GOOGLE_MAPS_API_KEY=

# Google Cloud: OAuth client of type "Web application" (used by Google sign-in)
GOOGLE_WEB_CLIENT_ID=
